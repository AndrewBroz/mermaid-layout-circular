{
  "name": "mermaid-layout-circular",
  "version": "0.10.1",
  "description": "A circular layout for mermaid flowcharts. Nodes sit on a circle, and arrows follow it.",
  "type": "module",
  "module": "dist/mermaid-layout-circular.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mermaid-layout-circular.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite demo",
    "build": "vite build && dts-bundle-generator --project tsconfig.build.json --external-inlines layout-circular --no-check --no-banner -o dist/index.d.ts src/index.ts",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "eslint . && tsc -p tsconfig.json",
    "docs:images": "node scripts/render-docs.mjs"
  },
  "keywords": [
    "mermaid",
    "mermaid-layout",
    "flowchart",
    "diagram",
    "layout",
    "circular",
    "circle",
    "cycle",
    "ring",
    "graph"
  ],
  "author": "Andrew Broz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewBroz/mermaid-layout-circular.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "mermaid": ">=11.12.0 <13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^10.8.0",
    "layout-circular": "^0.3.0",
    "mermaid": "^12.3.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "sideEffects": false,
  "homepage": "https://github.com/AndrewBroz/mermaid-layout-circular#readme",
  "bugs": {
    "url": "https://github.com/AndrewBroz/mermaid-layout-circular/issues"
  }
}
